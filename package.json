{
  "name": "jev-mcp-middleware",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "MCP middleware for semantic decision research and developer tooling",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:keyless": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "start": "node dist/index.js",
    "benchmark": "tsx src/benchmark/runBenchmark.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@typesafe-ai/sdk": "0.6.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.11.1",
    "pino": "10.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
